{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "server.js",
    "prisma7.config.ts"
  ],
  "exclude": [
    "node_modules",
    "MiApp",
    "dist"
  ],
  "extends": "expo/tsconfig.base"
}
